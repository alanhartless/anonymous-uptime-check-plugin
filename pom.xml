    <groupId>io.jenkins.plugins</groupId>
    <artifactId>anonymous-uptime-check</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>hpi</packaging>
    <!-- jenkins.version/java.level removed 2026-09-05: the pinned 2.7.3 /
         Java 7 baseline was a decade stale and Java 7 bytecode targets
         are rejected outright by modern javac. Inheriting the parent
         POM's own defaults (jenkins.version 2.479, maven.compiler.release
         17, as of plugin-pom 6.2221.va_045130417c9) keeps this in step
         with the parent's own supported baseline instead of drifting
         again the same way. -->
    <name>Anonymous Uptime Check</name>
    <description>Allows unauthenticated access to check ability to run new jobs at /healthz.
        If Jenkins is quieting down, the response is a 503, otherwise a success 200 json repsonse.
        This can be used for external tools to check track uptime statics of Jenkins instance.
    </description>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <!-- Assuming you want to host on @jenkinsci:
    <url>https://wiki.jenkins.io/display/JENKINS/TODO+Plugin</url>
    <scm>
        <connection>scm:git:git://github.com/jenkinsci/${project.artifactId}-plugin.git</connection>
        <developerConnection>scm:git:git@github.com:jenkinsci/${project.artifactId}-plugin.git</developerConnection>
        <url>https://github.com/jenkinsci/${project.artifactId}-plugin</url>
    </scm>
    -->
    <repositories>
        <repository>
            <id>repo.jenkins-ci.org</id>
            <url>https://repo.jenkins-ci.org/public/</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>repo.jenkins-ci.org</id>
            <url>https://repo.jenkins-ci.org/public/</url>
        </pluginRepository>
    </pluginRepositories>
</project>
